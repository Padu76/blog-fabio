# E:\blog-fabio\.env.example
# Copia in .env.local per lo sviluppo locale. In produzione le variabili si impostano su Vercel.
# MAI mettere valori reali in questo file.

# Indirizzo pubblico del sito (senza / finale)
NEXT_PUBLIC_SITE_URL=https://blog-fabio.vercel.app

# Supabase (istanza condivisa UtilityLab). URL e chiave publishable sono pubblici.
NEXT_PUBLIC_SUPABASE_URL=https://vzwplpljxdqmdejvzwuw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chiave segreta lato server: Supabase > Project Settings > API Keys > secret / service_role
SUPABASE_SERVICE_ROLE_KEY=

# Primo amministratore: questa email può entrare la prima volta (solo finché non esiste nessun operatore)
ADMIN_BOOTSTRAP_EMAIL=

# Correzione testi con Claude (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
EDITORIAL_MODEL=claude-haiku-5-5
AI_DAILY_LIMIT=30

# Google Books (gratuita): Google Cloud Console > API e servizi > Books API > Credenziali > Chiave API
GOOGLE_BOOKS_API_KEY=

# Funzione futura, spenta: trascrizione audio con OpenAI
FEATURE_AUDIO=false
OPENAI_API_KEY=
